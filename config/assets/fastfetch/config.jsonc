{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "~/.config/karin-shell/assets/fastfetch/7.png",
        "width": 45,   // МАКСИМАЛЬНО увеличили ширину картинки
        "height": 22,  // И высоту, чтобы заполнить окно
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3   // Чуть больше отступ до текста
        }
    },
    "display": {
        "separator": " \u001b[38;2;243;139;168m󰁔\u001b[0m ",
        "color": {
            "keys": "38;2;243;139;168",
            "title": "38;2;243;139;168"
        }
    },
    "modules": [
        // Текст сдвинут ещё ниже, чтобы быть по центру картинки
        "break",
        "break",
        "title",
        "break", 
        {
            "type": "os",
            "key": "󰣇 OS"
        },
        "break", 
        {
            "type": "kernel",
            "key": "󰞀 Kernel"
        },
        "break", 
        {
            "type": "uptime",
            "key": "󱎫 Uptime"
        },
        "break", 
        {
            "type": "packages",
            "key": "󰏖 Packages"
        },
        "break", 
        {
            "type": "shell",
            "key": "󰞷 Shell"
        },
        "break", 
        {
            "type": "wm",
            "key": "󱂬 WM"
        },
        "break", 
        {
            "type": "terminal",
            "key": " Terminal"
        },
        "break", 
        {
            "type": "cpu",
            "key": "󰻠 CPU"
        },
        "break", 
        {
            "type": "gpu",
            "key": "󰢮 GPU"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory"
        }
    ]
}

